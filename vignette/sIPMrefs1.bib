	note = {arXiv:2103.14315 [stat]},
	keywords = {Statistics - Computation},
	file = {PDF:/Users/fabianketwaroo/Zotero/storage/VBHBBMR3/Posch et al. - 2024 - Variable Selection Using Nearest Neighbor Gaussian Processes.pdf:application/pdf},
}

