	pages = {543--564},
	file = {PDF:/Users/fabianketwaroo/Zotero/storage/GYG3SHMG/S⊘rbye et al. - 2019 - Careful Prior Specification Avoids Incautious Inference for Log-Gaussian Cox Point Processes.pdf:application/pdf},
}

